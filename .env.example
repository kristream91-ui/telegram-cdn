# Copy this file to .env (or export the vars) and fill in your values.

# From https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# From @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# Optional: user session string instead of / in addition to the bot
# (needed only if you want to backfill an entire channel's history)
# SESSION_STRING=

# Optional: channel id whose media posts get auto-indexed (bot must be admin)
# INDEX_CHANNEL=-1001234567890

# Public URL of this web app (used in the links the bot replies with)
BASE_URL=http://localhost:8000

# Web server
HOST=0.0.0.0
PORT=8000
